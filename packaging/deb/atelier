#!/bin/bash
# Lance le service Atelier (systemd --user, sinon processus détaché) puis ouvre le navigateur.
conf="$HOME/.config/Atelier"  # = plat.config_dir()
port=$(sed -n '/^\[server\]/,/^\[/s/^port *= *\([0-9]\+\).*/\1/p' "$conf/config.toml" 2>/dev/null | head -1)
port=${port:-7777}
url=http://127.0.0.1:$port/
up() { (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; }
if ! up; then
  if ! systemctl --user start atelier.service 2>/dev/null; then
    mkdir -p "$conf"
    ATELIER_NO_WINDOW=1 setsid nohup /opt/atelier/Atelier >>"$conf/atelier.log" 2>&1 &
  fi
  for _ in $(seq 60); do up && break; sleep 0.5; done
fi
exec xdg-open "$url"
